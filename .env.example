# ====================================================
#               FAIRRIDE ENVIRONMENT CONFIGURATION
# ====================================================

# Port & Node Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Leave blank to automatically use the embedded in-memory database engine
MONGO_URI=mongodb://localhost:27017/fairride

# ====================================================
#               SUPABASE INTEGRATION
# ====================================================
# Server Build APIs
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_ANON_KEY=sb_publishable_...

# Client Library / Framework Environment Variables (Next.js / Vite / SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Redis Cache Service
REDIS_URL=redis://localhost:6379

# JWT Cryptographic Secrets (generate with `openssl rand -hex 32`)
JWT_SECRET=fairride_jwt_super_secret_production_key_2026
JWT_REFRESH_SECRET=fairride_jwt_refresh_super_secret_2026

# Payment Gateway (Razorpay API Configuration)
RAZORPAY_KEY_ID=rzp_test_fairride2026
RAZORPAY_KEY_SECRET=fairride_rzp_mock_secret_key
RAZORPAY_WEBHOOK_SECRET=fairride_webhook_secret_hmac256

# Google Maps / Mapbox Geocoding & Places Tokens
GOOGLE_MAPS_API_KEY=AIzaSyDemoFairRideMockKey2026
MAPBOX_TOKEN=pk.demo.fairride.mapbox.token

# Google OAuth Credentials
GOOGLE_CLIENT_ID=fairride-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fairride-oauth-client-secret

# SMS & Communication Provider (Twilio / MSG91 / Gupshup)
SMS_API_KEY=sms_provider_mock_api_key_2026
EMAIL_API_KEY=sendgrid_mock_api_key_2026

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000
